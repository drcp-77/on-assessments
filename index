  <script>
    const navButtons = document.querySelectorAll('.nav-btn');
    const panels = document.querySelectorAll('.panel');
    const themeToggle = document.getElementById('themeToggle');
    const answerBox = document.getElementById('answer-box');
    const answerText = document.getElementById('answer-text');
    const questionText = document.getElementById('question-text');
    const showAnswerBtn = document.getElementById('show-answer');
    const nextQuestionBtn = document.getElementById('next-question');

    const questions = [
      {
        question: "Can you give an example of how you used research and evidence to redesign an assessment?",
        answer: "I redesigned the assessment model for the URJC module Didactics of Social Sciences II. The previous model relied mostly on a final written exam, which did not reflect the critical, reflective and practical competences the programme aimed for. I reviewed the learning outcomes, university regulations and research on literacy, audiovisual literacy and citizenship education, and designed a continuous assessment model combining a written test, a group project using heritage or audiovisual materials, a case study and a commentary focused on quality in education. I defined clear weightings, minimum pass thresholds, re-evaluation rules, plagiarism and writing expectations and shared the design with colleagues for feedback. The new model is better aligned with the aims, gives students multiple ways to show what they know and can do, and has improved both transparency and the coherence of grade distributions."
      },
      {
        question: "Can you give an example of how you used research and evidence to design an assessment or instrument related to AI?",
        answer: "TeacherAID is a good example. We needed an instrument to capture teachers’ nuanced judgements about AI in education, rather than just simple attitude scores. I reviewed literature on AI in education, teacher decision-making and attitude measurement, and we designed a multi-component instrument with an ethical consent screen, factorial vignettes that simulate realistic AI scenarios, and response formats such as sliders, rankings and card sorting. We iteratively piloted and refined the wording and scales to ensure clarity, to minimise bias and to produce data that support the analyses we planned. The result is an instrument that provides rich, structured evidence on how teachers weigh opportunities, risks and contextual factors around AI, and it shows how I combine theory, methodology and practical constraints in assessment design."
      },
      {
        question: "How does your research profile influence your approach to assessment design?",
        answer: "My research profile, documented in my ORCID record, covers literacy, audiovisual literacy, social sciences didactics, citizenship education and AI-related conceptual frameworks. This means I approach assessment design with research questions in mind: what exactly are we measuring, how authentic is the task, what kinds of responses we will elicit, and how different learner groups might experience the assessment. My work on audiovisual literacy and heritage leads me to use contextualised, multimodal tasks rather than only traditional written exams, and my work on citizenship and AI encourages me to emphasise critical thinking, judgement and ethical reflection."
      },
      {
        question: "Describe a situation where you ensured assessments complied with regulations or organisational requirements.",
        answer: "My external examiner and end-point assessment roles are strong examples. I interpret programme specifications, learning outcomes, assessment criteria, apprenticeship assessment plans and organisational guidance, and then review sampled work and decisions against those frameworks. I identify inconsistencies or risks, provide structured written feedback and contribute to standardisation and action planning. I also explicitly cross-check with current regulatory guidance, particularly around validity, reliability, comparability, manageability and minimising bias, rather than relying on assumptions."
      },
      {
        question: "How has AI changed your thinking about assessment design?",
        answer: "AI has increased the risk that purely theoretical written tasks can be completed by tools rather than learners. In response, I design and recommend assessments that foreground scenario analysis, authentic application and reflective judgement. Projects like TeacherAID have reinforced the value of realistic vignettes and rich response formats, and in my teaching and QA work I prioritise tasks where learners have to interpret context, make decisions and justify their reasoning. This keeps the focus on the thinking and professional judgement we really want to see."
      },
      {
        question: "What do you bring to NCFE beyond practical assessment experience?",
        answer: "Beyond hands-on assessment and QA experience, I bring a strong research-informed perspective. My ORCID profile shows ongoing work on literacy, audiovisual literacy, social sciences didactics, citizenship education and AI-related frameworks. That means when I design or review assessments, I connect practice with current research on how assessments influence learning, equity and professional practice, and I deliberately use concepts like validity, reliability, comparability, accessibility and bias when I evaluate and improve assessment strategies."
      }
    ];

    let currentIndex = 0;

    function showSection(sectionId) {
      panels.forEach(panel => {
        panel.classList.toggle('active', panel.id === sectionId);
      });

      navButtons.forEach(button => {
        button.classList.toggle('active', button.dataset.section === sectionId);
      });
    }

    navButtons.forEach(button => {
      button.addEventListener('click', () => {
        showSection(button.dataset.section);
      });
    });

    function renderQuestion(index) {
      const item = questions[index];
      questionText.textContent = item.question;
      answerText.textContent = item.answer;
      answerBox.classList.add('hidden');
    }

    showAnswerBtn.addEventListener('click', () => {
      answerBox.classList.remove('hidden');
    });

    nextQuestionBtn.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % questions.length;
      renderQuestion(currentIndex);
    });

    (function initTheme() {
      const root = document.documentElement;
      let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      root.setAttribute('data-theme', theme);

      themeToggle.addEventListener('click', () => {
        theme = theme === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', theme);
      });
    })();

    renderQuestion(0);
    showSection('overview');
  </script>
